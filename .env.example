# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fintax_platform
DB_USER=root
DB_PASSWORD=your_db_password

# JWT
JWT_SECRET=replace_with_a_long_random_string_at_least_32_characters
JWT_EXPIRATION=86400000

# CORS - comma-separated frontend URLs allowed to call this API
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-deployed-frontend.vercel.app

# Server
SERVER_PORT=8080
